# Loaded by assistant-service in the integration test stack only
# (docker-compose.test.yml). Points the assistant at the scripted fake model.
# Not a secret: the fake accepts any key.
OPENROUTER_API_KEY=test-key-not-real
OPENROUTER_BASE_URL=http://fake-openrouter:4099/api/v1
OPENROUTER_MODEL=fake/scripted
OPENROUTER_MAX_TOKENS=256
