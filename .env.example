# Copy to .env and edit. Every value below is optional: docker-compose.yml
# carries the same defaults, so the stack boots on a fresh clone with no .env at
# all. Set a value here to override the default.
#
# .env is gitignored. Do not commit it.


# =============================================================================
# DATABASE
# =============================================================================
#
# One database shared by every service — there is no per-service isolation in
# this MVP. DB_HOST is the compose service name, not localhost: containers reach
# each other over the Docker network.
#
# Postgres is NOT published to the host. Reach it with:
#   docker compose exec postgres psql -U app_user -d customer_management

DB_HOST=postgres
DB_PORT=5432
DB_NAME=customer_management
DB_USER=app_user
DB_PASSWORD=app_password


# =============================================================================
# REDIS
# =============================================================================
#
# Used by dashboard-service for caching and by email-service. REDIS_URL is the
# in-network address; REDIS_HOST_PORT is only for connecting from your machine.

REDIS_URL=redis://redis:6379
REDIS_HOST_PORT=6379


# =============================================================================
# AUTHENTICATION (ORY HYDRA)
# =============================================================================
#
# Ory Hydra issues every access and refresh token and keeps the sign-in
# sessions. Access tokens are RS256-signed and last 5 minutes. Nothing is
# signed with a shared secret: each service checks a token against Hydra's
# public keys (JWKS), its issuer URL and the omnicore-api audience. identity-service keeps
# the users and passwords and tells Hydra who signed in. Hydra's public API is
# reached through Kong (/oauth2/*, /.well-known/*, /userinfo); its admin API is
# never published or routed.
#
# A role or permission change reaches someone signed in at their next refresh
# (within 5 minutes): identity-service rebuilds the claims every time. Just-in-
# time access grants are read live on every request.
#
# Each has a development default in docker-compose.yml so a fresh clone
# boots. A real deployment sets all four, and assistant-service
# never holds any of them (blanked there).
#
# HYDRA_SECRETS_SYSTEM  encrypts Hydra's data at rest; at least 32 characters.
#                       Changing it makes stored data unreadable unless the old
#                       value is kept as a second, rotated-out secret.
# HYDRA_DB_PASSWORD     the password of Hydra's own database role. The migrate
#                       service creates the `hydra` database and role, and sets
#                       this password on every start.
# OAUTH_CLIENT_SECRET   identity-service's client secret in Hydra (client
#                       `omnicore-web`). Held by identity-service only, which
#                       registers the client on boot.
#
# TOKEN_HOOK_SECRET     the shared secret Hydra presents when it asks
#                       identity-service to rebuild a token's claims (every
#                       refresh). Held by Hydra and identity-service only.
#
# HYDRA_SECRETS_SYSTEM=<at least 32 random characters>
# HYDRA_DB_PASSWORD=<random>
# OAUTH_CLIENT_SECRET=<random>
# TOKEN_HOOK_SECRET=<random>

# The refresh token lives in an httpOnly cookie scoped to /api/auth. Secure
# cookies need HTTPS, so this is off for the plain-http local stack; a real
# deployment sets it to true.
AUTH_COOKIE_SECURE=false

# Session lifetimes. Access tokens are short (Hydra's ttl.access_token). Each
# refresh issues a refresh token with a fresh lifetime, so HYDRA_TTL_REFRESH_TOKEN
# is the idle timeout: not used for that long, a session is over. However
# active, a session ends AUTH_SESSION_MAX_AGE after the password was typed
# (checked by identity-service's token hook).
HYDRA_TTL_ACCESS_TOKEN=5m
HYDRA_TTL_REFRESH_TOKEN=168h
AUTH_SESSION_MAX_AGE=720h

# Hydra's database and role names (plain lower-case names only).
HYDRA_DB_NAME=hydra
HYDRA_DB_USER=hydra

# Extra flags for `hydra serve all`. Unset, it is `--dev`, which allows the
# plain-http issuer and redirect URLs of a local stack. Behind HTTPS, set it
# empty: HYDRA_SERVE_FLAGS=
# HYDRA_SERVE_FLAGS=--dev


# =============================================================================
# SERVICE PORTS
# =============================================================================
#
# *_SERVICE_PORT is the port inside the container. *_SERVICE_HOST_PORT is what
# is published to your machine, for debugging only — the frontend and all
# service-to-service calls go through the gateway or Docker DNS.
#
# WARNING: the internal ports are also written into kong/kong.yml, which is a
# separate submodule and is not templated from here. Change a *_SERVICE_PORT and
# you must edit kong.yml to match, or the gateway will route to a dead port.
# Changing only a *_HOST_PORT is always safe.

LEAD_SERVICE_PORT=4001
LEAD_SERVICE_HOST_PORT=4001

CUSTOMER_SERVICE_PORT=4002
CUSTOMER_SERVICE_HOST_PORT=4002

SERVICE_SERVICE_PORT=4003
SERVICE_SERVICE_HOST_PORT=4003

IDENTITY_SERVICE_PORT=4004
IDENTITY_SERVICE_HOST_PORT=4004

DASHBOARD_SERVICE_PORT=4005
DASHBOARD_SERVICE_HOST_PORT=4005

EMAIL_SERVICE_PORT=4006
EMAIL_SERVICE_HOST_PORT=4006

ASSISTANT_SERVICE_PORT=4007
ASSISTANT_SERVICE_HOST_PORT=4007

# Profession-bundle capability services.
BUNDLE_SERVICE_PORT=4008
BUNDLE_SERVICE_HOST_PORT=4008

ENGAGEMENT_SERVICE_PORT=4009
ENGAGEMENT_SERVICE_HOST_PORT=4009

OBLIGATION_SERVICE_PORT=4010
OBLIGATION_SERVICE_HOST_PORT=4010

DOCUMENT_SERVICE_PORT=4011
DOCUMENT_SERVICE_HOST_PORT=4011

VAULT_SERVICE_PORT=4012
VAULT_SERVICE_HOST_PORT=4012


# =============================================================================
# GATEWAY AND FRONTEND
# =============================================================================
#
# Host ports only. Kong's proxy listens on 8000 inside its container and the
# frontend's start script pins Vite to 3000, so neither container side is
# configurable from here.
#
KONG_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# How long Kong trusts its DNS answer for an upstream service, in seconds.
# Kept short so a recreated container (new IP) is picked up within seconds
# rather than after Docker's 600 s TTL. STALE_TTL=0 stops Kong serving an
# expired answer while it re-resolves; NOT_FOUND_TTL covers a service that is
# briefly absent mid-recreate.
KONG_DNS_VALID_TTL=5
KONG_DNS_STALE_TTL=0
KONG_DNS_NOT_FOUND_TTL=5

# Where the browser reaches Kong. Left unset it follows KONG_HOST_PORT
# automatically; set it explicitly when the gateway is not on this machine.
#
# Vite writes VITE_* into the bundle when the frontend image is built, so a
# change needs `docker compose up -d --build frontend` — it is not read at run
# time. VITE_ is also the only prefix Vite exposes to browser code.
VITE_API_BASE_URL=http://localhost:8080/api

# Used by assistant-service when identifying itself to OpenRouter.
PUBLIC_APP_URL=http://localhost:3000


# =============================================================================
# BOOTSTRAP AND SEEDING
# =============================================================================
#
# Read by the migrate service. Existing rows are never modified: if the
# organization slug or admin email already exists, the seed reuses it and leaves
# the password untouched.
#
# FIRST ADMIN — two ways, and no default password:
#   - Leave BOOTSTRAP_ADMIN_EMAIL and BOOTSTRAP_ADMIN_PASSWORD unset (the
#     default): the first visit to the app opens a setup screen where you name
#     the organization and choose your own admin login. It asks for a one-time
#     setup code, printed by:   docker compose logs migrate
#   - Set both (CI, scripted deployments): the admin is created from them. The
#     password needs 12+ characters. Setting only one is refused.

BOOTSTRAP_ORG_NAME=Acme Corporation
BOOTSTRAP_ORG_SLUG=acme-corporation

BOOTSTRAP_ADMIN_NAME=Admin
# BOOTSTRAP_ADMIN_EMAIL=admin@yourfirm.example
# BOOTSTRAP_ADMIN_PASSWORD=

# The profession bundle first-run setup installs for the new organization.
# Empty: setup installs none (the plain CRM).
SETUP_BUNDLE=ca-practice

# Seeds demo data on an empty database: two leads, one of them converted into a
# customer. Skipped entirely once any lead or customer exists, so it never
# touches a database already in use. Set to false for a real deployment.
SEED_DEMO_DATA=true


# =============================================================================
# VECTOR SEARCH (Qdrant)
# =============================================================================
#
# Shared secret between Qdrant and assistant-service — not an account or a paid
# key; generate your own:
#
#   openssl rand -hex 32
#
# Qdrant is not published to the host, but without a key any container on the
# Docker network could read the conversation vectors. Left empty, Qdrant runs
# unauthenticated. Both containers read it the same way, so changing it only
# needs `docker compose up -d qdrant assistant-service`.

QDRANT_API_KEY=


# =============================================================================
# CLIENT FILES AND CREDENTIALS VAULT (vault-service)
# =============================================================================
#
# Client files are stored in SeaweedFS, an S3-compatible store that runs as the
# `seaweedfs` container. It is not published to the host, and only
# vault-service is given these keys. Both are self-generated secrets, not a
# cloud account:
#
#   openssl rand -hex 16    (access key)
#   openssl rand -hex 32    (secret key)
#
# Left unset, development defaults are used — never anonymous access, but the
# defaults are in this repository, so set your own for anything real.
# Changing them needs `docker compose up -d seaweedfs vault-service`.

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=client-files

# Encrypts every stored portal password (AES-256-GCM, through a data key per
# organization). Losing it makes the stored passwords unreadable; leaking it,
# together with a database copy, exposes them. Generate once and back it up
# separately from the database:
#
#   openssl rand -base64 32
#
# Only vault-service receives it; assistant-service has it blanked.

VAULT_MASTER_KEY=


# =============================================================================
# SERVICE-TO-SERVICE (background workers)
# =============================================================================
#
# Work with no signed-in person behind it signs a narrow, short service token
# with this secret, each for one scope that one email-service route accepts:
# the daily deadline reminders (obligation-service, "automations.trigger") and
# account email such as verification links (identity-service,
# "system-mail.send"). Keep it different from every other secret. Generate
# your own:
#
#   openssl rand -hex 32
#
# Left unset, a development default is used. assistant-service has it blanked.

SERVICE_JWT_SECRET=

# =============================================================================
# TWO-FACTOR SIGN-IN
# =============================================================================
#
# Encrypts each person's authenticator-app secret at rest (auth hardening P5).
# 32 random bytes, base64 — held by identity-service only, blanked for
# assistant-service. Left unset, a development default is used; set your own
# for a real deployment:
#
#   openssl rand -base64 32
#
# Keep it backed up: without it no stored secret can be read, and everyone
# who uses two-factor has to set it up again (an admin resets them).

MFA_ENCRYPTION_KEY=

# =============================================================================
# SYSTEM MAIL (account email)
# =============================================================================
#
# The platform's own mail about accounts — the link that confirms a new
# member's email address, or a changed one (auth hardening P4) — sent by
# email-service, which alone holds these. Never an organization's own mail
# account: a fresh install has none.
#
# Left unset, nothing is mailed: creating a member shows the admin the link to
# pass on, and a changed email address cannot be confirmed. The test stack
# points it at Mailpit.

SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_SECURE=false
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASSWORD=
SYSTEM_SMTP_FROM="OmniCore <no-reply@example.com>"


# =============================================================================
# AI ASSISTANT (OpenRouter)
# =============================================================================
#
# The assistant answers 503 until a key is set; everything else in the product
# runs without one.
#
# These three are handled differently from everything above. assistant-service
# reads them through docker-compose's env_file rather than ${VAR} interpolation,
# because interpolation prefers a value exported in your shell and would
# silently override this file. env_file never consults the shell, so .env is the
# only source.
#
# Consequences worth knowing: do not add OPENROUTER_* under that service's
# `environment:` — entries there beat env_file and would reinstate shell
# precedence. And because env_file loads the whole file, the BOOTSTRAP_* values
# above are explicitly blanked for that one container so the service that talks
# to an external model is not also holding the seed admin password.
#
# Any OpenRouter model with tool-calling works. OPENROUTER_MAX_TOKENS defaults
# to 1024 in code; the provider's own default is far larger and is billed
# against your account's headroom.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free
OPENROUTER_MAX_TOKENS=1024

# =============================================================================
# TUNING
# =============================================================================
#
# Limits, lifetimes and timings. Every one is optional: left unset, each takes
# the value shown, which is what the product ships with. A value that is set
# but not a valid number stops the service that reads it at start-up.

# --- Shared by every service ---------------------------------------------------
# The product's name where people see it: authenticator apps, account email,
# OpenRouter's dashboard. (The web app's own branding is in its code.)
APP_NAME=OmniCore
# The audience every service requires in Hydra's tokens.
OAUTH_AUDIENCE=omnicore-api
# How long one service waits for another, or for Hydra (ms).
SERVICE_CALL_TIMEOUT_MS=10000
# How long a service remembers an organization's installed bundle (ms).
BUNDLE_CACHE_TTL_MS=60000
# Queuing an automation from lead-, customer- and engagement-service.
AUTOMATION_NOTIFY_ATTEMPTS=2
AUTOMATION_NOTIFY_TIMEOUT_MS=3000

# --- Passwords (identity-service, the seed, and the forms in the web app) ------
# bcrypt cost: each +1 doubles the time to hash and to guess. At least 10.
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=8
# The first admin, created by setup or by BOOTSTRAP_* below.
ADMIN_PASSWORD_MIN_LENGTH=12

# --- Sign-in, setup and access (identity-service) ------------------------------
EMAIL_VERIFICATION_TTL_HOURS=24
# The first-run setup code: its lifetime, and wrong tries before it locks.
SETUP_CODE_TTL_HOURS=24
SETUP_MAX_FAILED_ATTEMPTS=10
SETUP_BUNDLE_INSTALL_TIMEOUT_MS=120000
# The longest a just-in-time access grant may run.
ACCESS_GRANT_MAX_MINUTES=1440
# How long a sign-in may sit between its steps (Hydra, password, code).
SIGN_IN_STEP_TTL_MINUTES=10
# Two-factor: wrong codes before it locks, for how long, and recovery codes.
MFA_MAX_FAILED_CODES=5
MFA_LOCK_MINUTES=15
MFA_RECOVERY_CODES=10
# Browser origins allowed to call identity-service with the refresh cookie
# (comma-separated). Unset, PUBLIC_APP_URL alone.
CORS_ORIGINS=
AUTH_COOKIE_PATH=/api/auth

# --- Email (email-service) -----------------------------------------------------
AUTOMATION_POLL_INTERVAL_MS=10000
AUTOMATION_BATCH_SIZE=10
# Tries to send one automated email before it is marked failed.
AUTOMATION_MAX_ATTEMPTS=5
EMAIL_RECEIVER_SYNC_MS=60000
# The domain in outgoing Message-IDs. Unset, the sending account's own.
EMAIL_MESSAGE_ID_DOMAIN=

# --- Client files and the vault (vault-service, and the upload form) -----------
# Kong's request-size-limiting (kong/kong.yml) allows 26 MB: raising this
# past 25 needs that raised too.
VAULT_MAX_FILE_MB=25
# Password reveals per person per window (ms).
VAULT_REVEALS_PER_WINDOW=10
VAULT_REVEAL_WINDOW_MS=600000
# How often a purged client's files are swept from the store (ms).
VAULT_SWEEP_INTERVAL_MS=600000
S3_REGION=us-east-1

# --- Bundles, clients, deadlines, dashboard ------------------------------------
BUNDLE_INSTALL_LEASE_MS=120000
BUNDLE_STEP_TIMEOUT_MS=30000
CSV_IMPORT_MAX_ROWS=1000
CSV_IMPORT_MAX_MB=2
# A deadline this many days away or fewer is "due soon".
OBLIGATION_DUE_SOON_DAYS=30
# Remind this many days before a deadline; keep reminding about an overdue one
# for this many days; deadlines read per pass.
OBLIGATION_REMINDER_DAYS=7
OBLIGATION_OVERDUE_WINDOW_DAYS=30
OBLIGATION_REMINDER_BATCH=200
DASHBOARD_CACHE_SECONDS=30

# --- The assistant (assistant-service, which reads this whole file) ------------
# A turn: model round trips, its total time and one model call's (ms).
ASSISTANT_MAX_STEPS=6
ASSISTANT_TURN_BUDGET_MS=240000
ASSISTANT_MODEL_TIMEOUT_MS=60000
ASSISTANT_TOOL_TIMEOUT_MS=20000
QDRANT_TIMEOUT_MS=10000
# How long a turn holds its conversation: must be longer than the turn budget.
ASSISTANT_LEASE_SECONDS=300
# How much of a thread is replayed to the model, and a message's length.
ASSISTANT_CONTEXT_MESSAGES=40
ASSISTANT_CONTEXT_CHARS=8000
ASSISTANT_MAX_MESSAGE_CHARS=8000
# Conversation search, recall into the prompt, and help articles (0–1).
SEARCH_RESULTS=20
SEARCH_CANDIDATES=40
SEARCH_MIN_SIMILARITY=0.3
RECALL_LIMIT=4
RECALL_MIN_SIMILARITY=0.4
HELP_RESULTS=3
HELP_MIN_SIMILARITY=0.3
# The background embedder.
EMBEDDING_BATCH=32
EMBEDDING_IDLE_MS=2000
EMBEDDING_MAX_BACKOFF_MS=30000
