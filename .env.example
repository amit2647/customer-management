# Bootstrap identity created by the migrate service on an empty database.
# Existing rows are never modified: if the organization slug or admin email
# already exists, the seed reuses it and leaves the password untouched.

BOOTSTRAP_ORG_NAME=Acme Corporation
BOOTSTRAP_ORG_SLUG=acme-corporation

BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@acme.example
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Seeds demo data on an empty database: two leads, one of them converted into
# a customer. Skipped entirely once any lead or customer exists, so it never
# touches a database already in use. Set to false for a real deployment.
SEED_DEMO_DATA=true

# AI assistant. The assistant answers 503 until a key is set; everything else
# in the product runs without one.
# Any OpenRouter model with tool-calling works — change the model if the
# default is not enabled on your account.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free
