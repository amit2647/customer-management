# Copy to .env and edit. Every value below is optional: docker-compose.yml
# carries the same defaults, so the stack boots on a fresh clone with no .env at
# all. Set a value here to override the default.
#
# .env is gitignored. Do not commit it.


# =============================================================================
# DATABASE
# =============================================================================
#
# One database shared by every service — there is no per-service isolation in
# this MVP. DB_HOST is the compose service name, not localhost: containers reach
# each other over the Docker network.
#
# Postgres is NOT published to the host. Reach it with:
#   docker compose exec postgres psql -U app_user -d customer_management

DB_HOST=postgres
DB_PORT=5432
DB_NAME=customer_management
DB_USER=app_user
DB_PASSWORD=app_password


# =============================================================================
# REDIS
# =============================================================================
#
# Used by dashboard-service for caching and by email-service. REDIS_URL is the
# in-network address; REDIS_HOST_PORT is only for connecting from your machine.

REDIS_URL=redis://redis:6379
REDIS_HOST_PORT=6379


# =============================================================================
# AUTHENTICATION
# =============================================================================
#
# JWT_SECRET is shared by every service, which each verify tokens independently
# rather than calling back to identity-service. A real deployment would not keep
# a default for this.
#
# Permissions are baked into the token at login, so JWT_EXPIRES_IN is also how
# long a role change takes to reach someone already signed in. Just-in-time
# access grants are the exception — they are read live on every request.

JWT_SECRET=omnicore-development-secret-change-this
JWT_ISSUER=omnicore-identity-service
JWT_EXPIRES_IN=8h


# =============================================================================
# SERVICE PORTS
# =============================================================================
#
# *_SERVICE_PORT is the port inside the container. *_SERVICE_HOST_PORT is what
# is published to your machine, for debugging only — the frontend and all
# service-to-service calls go through the gateway or Docker DNS.
#
# WARNING: the internal ports are also written into kong/kong.yml, which is a
# separate submodule and is not templated from here. Change a *_SERVICE_PORT and
# you must edit kong.yml to match, or the gateway will route to a dead port.
# Changing only a *_HOST_PORT is always safe.

LEAD_SERVICE_PORT=4001
LEAD_SERVICE_HOST_PORT=4001

CUSTOMER_SERVICE_PORT=4002
CUSTOMER_SERVICE_HOST_PORT=4002

SERVICE_SERVICE_PORT=4003
SERVICE_SERVICE_HOST_PORT=4003

IDENTITY_SERVICE_PORT=4004
IDENTITY_SERVICE_HOST_PORT=4004

DASHBOARD_SERVICE_PORT=4005
DASHBOARD_SERVICE_HOST_PORT=4005

EMAIL_SERVICE_PORT=4006
EMAIL_SERVICE_HOST_PORT=4006

ASSISTANT_SERVICE_PORT=4007
ASSISTANT_SERVICE_HOST_PORT=4007


# =============================================================================
# GATEWAY AND FRONTEND
# =============================================================================
#
# Host ports only. Kong's proxy listens on 8000 inside its container and the
# frontend's start script pins Vite to 3000, so neither container side is
# configurable from here.
#
KONG_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# Where the browser reaches Kong. Left unset it follows KONG_HOST_PORT
# automatically; set it explicitly when the gateway is not on this machine.
#
# Vite substitutes VITE_* at transform time, so the frontend container has to be
# restarted for a change to reach the page — it is not read per request. VITE_
# is also the only prefix Vite exposes to browser code.
VITE_API_BASE_URL=http://localhost:8080/api

# Used by assistant-service when identifying itself to OpenRouter.
PUBLIC_APP_URL=http://localhost:3000


# =============================================================================
# BOOTSTRAP AND SEEDING
# =============================================================================
#
# Read by the migrate service. Existing rows are never modified: if the
# organization slug or admin email already exists, the seed reuses it and leaves
# the password untouched.

BOOTSTRAP_ORG_NAME=Acme Corporation
BOOTSTRAP_ORG_SLUG=acme-corporation

BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@acme.example
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Seeds demo data on an empty database: two leads, one of them converted into a
# customer. Skipped entirely once any lead or customer exists, so it never
# touches a database already in use. Set to false for a real deployment.
SEED_DEMO_DATA=true


# =============================================================================
# AI ASSISTANT (OpenRouter)
# =============================================================================
#
# The assistant answers 503 until a key is set; everything else in the product
# runs without one.
#
# These three are handled differently from everything above. assistant-service
# reads them through docker-compose's env_file rather than ${VAR} interpolation,
# because interpolation prefers a value exported in your shell and would
# silently override this file. env_file never consults the shell, so .env is the
# only source.
#
# Consequences worth knowing: do not add OPENROUTER_* under that service's
# `environment:` — entries there beat env_file and would reinstate shell
# precedence. And because env_file loads the whole file, the BOOTSTRAP_* values
# above are explicitly blanked for that one container so the service that talks
# to an external model is not also holding the seed admin password.
#
# Any OpenRouter model with tool-calling works. OPENROUTER_MAX_TOKENS defaults
# to 1024 in code; the provider's own default is far larger and is billed
# against your account's headroom.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-sante:free
OPENROUTER_MAX_TOKENS=1024
